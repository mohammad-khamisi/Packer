# Normally generated by Terraform (terraform/templates/hosts.ini.tftpl).
# For existing VMs, copy to hosts.ini and edit.

[masters]
k8s-master-01 ansible_host=192.168.10.11
k8s-master-02 ansible_host=192.168.10.12
k8s-master-03 ansible_host=192.168.10.13

[workers]
k8s-worker-01 ansible_host=192.168.10.21
k8s-worker-02 ansible_host=192.168.10.22
k8s-worker-03 ansible_host=192.168.10.23

[k8s_cluster:children]
masters
workers

[k8s_cluster:vars]
ansible_user=ansible
ansible_ssh_private_key_file=~/.ssh/id_ed25519
