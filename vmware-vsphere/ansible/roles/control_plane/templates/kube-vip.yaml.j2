# Managed by Ansible – kube-vip floats the API VIP {{ control_plane_vip }} between masters (ARP mode)
apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:{{ kube_vip_version }}
      imagePullPolicy: IfNotPresent
      args: ["manager"]
      env:
        - { name: vip_arp, value: "true" }
        - { name: port, value: "{{ control_plane_port }}" }
        - { name: vip_interface, value: "{{ ansible_default_ipv4.interface }}" }
        - { name: vip_subnet, value: "32" }
        - { name: dns_mode, value: first }
        - { name: cp_enable, value: "true" }
        - { name: cp_namespace, value: kube-system }
        - { name: vip_leaderelection, value: "true" }
        - { name: vip_leasename, value: plndr-cp-lock }
        - { name: vip_leaseduration, value: "5" }
        - { name: vip_renewdeadline, value: "3" }
        - { name: vip_retryperiod, value: "1" }
        - { name: address, value: "{{ control_plane_vip }}" }
        - { name: prometheus_server, value: ":2112" }
      securityContext:
        capabilities:
          add: [NET_ADMIN, NET_RAW]
      volumeMounts:
        - mountPath: /etc/kubernetes/admin.conf
          name: kubeconfig
  hostAliases:
    - hostnames: [kubernetes]
      ip: 127.0.0.1
  hostNetwork: true
  volumes:
    - name: kubeconfig
      hostPath:
        # During the first `kubeadm init` admin.conf has no RBAC rights yet, so super-admin.conf is used
        path: {{ kube_vip_kubeconfig }}
