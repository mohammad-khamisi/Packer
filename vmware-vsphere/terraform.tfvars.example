# Copy to terraform.tfvars and edit:  cp terraform.tfvars.example terraform.tfvars
# Set the password via environment instead of this file:
#   export TF_VAR_vsphere_password='...'

# --- vCenter -----------------------------------------------------------------
vsphere_server               = "vcenter.example.local"
vsphere_user                 = "administrator@vsphere.local"
vsphere_allow_unverified_ssl = true

datacenter = "Datacenter"
cluster    = "Cluster01"
datastore  = "datastore1"
network    = "VM Network"
template   = "rocky10.2-template" # prepared with scripts/prepare-template.sh

folder        = "terraform-vms"
create_folder = true

# Rocky Linux 10 guest type (vSphere 8+). On vSphere 7 use "centos9_64Guest".
guest_id = "rockylinux_64Guest"

# --- Network (cloud-init, first boot) ----------------------------------------
domain       = "example.local"
ipv4_netmask = 24
ipv4_gateway = "192.168.10.1"
dns_servers  = ["192.168.10.1", "8.8.8.8"]

# --- Guest OS ----------------------------------------------------------------
time_zone           = "Asia/Tehran"
admin_user          = "rocky"
ssh_authorized_keys = ["ssh-ed25519 AAAA... you@laptop"]
# admin_password_hash = "$6$..."   # openssl passwd -6

packages = ["vim-enhanced", "bash-completion", "chrony", "tar", "curl", "wget", "git"]

# Very early on every boot, before the network (cloud-init bootcmd)
early_commands = [
  "echo 'early boot' >> /var/log/early-boot.log",
]

# Once, at the end of the first boot (cloud-init runcmd)
first_boot_commands = [
  "systemctl enable --now chronyd",
  "nmcli general hostname",
]

# --- After creation (Terraform over SSH, as root) ----------------------------
# Scripts in scripts/post-create/*.sh run first, then these commands.
enable_post_create   = true
ssh_private_key_path = "~/.ssh/id_ed25519"
post_create_commands = [
  "dnf -y install htop",
]

# --- VMs ---------------------------------------------------------------------
vms = {
  "web-01" = {
    cpus         = 2
    memory_mb    = 4096
    disk_gb      = 40
    ipv4_address = "192.168.10.51"

    extra_packages       = ["nginx"]
    post_create_commands = [
      "systemctl enable --now nginx",
      "firewall-cmd --permanent --add-service=http --add-service=https",
      "firewall-cmd --reload",
    ]
  }

  "db-01" = {
    cpus           = 4
    memory_mb      = 8192
    disk_gb        = 60
    extra_disks_gb = [100]
    ipv4_address   = "192.168.10.52"

    first_boot_commands = [
      # Format and mount the second disk
      "mkfs.xfs -L data /dev/sdb",
      "mkdir -p /data",
      "echo 'LABEL=data /data xfs defaults 0 0' >> /etc/fstab",
      "systemctl daemon-reload",
      "mount -a",
    ]
  }

  # DHCP example (no ipv4_address):
  # "test-01" = {}
}
